# Copy to the generated runtime's pi.env file (ignored by git) or export these variables.
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_API_KEY=replace-with-secret
PI_MAIN_MODEL=litellm/llm-large
MAX_SUBAGENT_DEPTH=2
MAX_SUBAGENT_CALLS=12
MAX_AGENT_TURNS=20
PI_MAX_CONCURRENT=4
PI_DEFAULT_DELEGATION_SET=default
PI_FORCE_CONTEXT_MODE=1
PI_REPOVERITY_ENABLED=0
PI_REPOVERITY_REQUIRED=0
# Optional: set these to generate a RepoVerity MCP gateway entry when the target repo has no .vscode/mcp.json.
# PI_REPOVERITY_COMMAND=/home/you/.local/share/repoverity-mcp/repoverity/bin/repoverity-mcp-gateway
# PI_REPOVERITY_REPOSITORY=repository-id
# PI_REPOVERITY_LOGICAL_REF=development
# PI_REPOVERITY_REMOTE_URL=https://repoverity.example
# PI_REPOVERITY_TOKEN_FILE=/home/you/.config/repoverity/codex.token
