{
  "version": 1,
  "mode": "off",
  "provider": {
    "name": "openrouter",
    "model": "typesafe/jev-1.13",
    "api_key_env": "OPENROUTER_API_KEY"
  },
  "timeout_ms": 1500,
  "max_calls_per_task": 1,
  "fallback": "existing_behavior",
  "decisions": {
    "delegation_set": {
      "enabled": true,
      "allowed_values": ["default", "fast", "balanced", "deep"],
      "min_choice_probability": 0.9,
      "min_confidence": 0.8
    },
    "initial_role": {
      "enabled": false,
      "allowed_values": ["orchestrator", "researcher", "coder", "tester", "reviewer"],
      "min_choice_probability": 0.9,
      "min_confidence": 0.8
    },
    "research_first": {
      "enabled": false,
      "allowed_values": ["yes", "no"],
      "min_choice_probability": 0.9,
      "min_confidence": 0.8
    },
    "request_sufficiency": {
      "enabled": false,
      "allowed_values": ["sufficient", "needs_clarification"],
      "min_choice_probability": 0.9,
      "min_confidence": 0.8
    },
    "additional_review_focus": {
      "enabled": false,
      "allowed_values": ["none", "tests", "security", "architecture", "regression"],
      "min_choice_probability": 0.9,
      "min_confidence": 0.8
    }
  }
}
